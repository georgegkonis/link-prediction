{
  "name": "Link Prediction Container",
  "dockerFile": "Dockerfile",
  "context": ".",
  "appPort": [
    8888
  ],
  "extensions": [
    "ms-python.python",
    "ms-toolsai.jupyter",
    "ms-vscode-remote.remote-containers"
  ],
  "settings": {
    "terminal.integrated.shell.linux": "/bin/bash"
  },
  "runArgs": [
    "--init"
  ],
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "remoteUser": "root"
}
